# Copy this file to .env (not tracked by git) and fill in your MQTT broker connection details.
# Values here take precedence over mqtt_host/mqtt_port/mqtt_user/mqtt_pwd in enoceanmqtt.conf.
# Leave MQTT_USER/MQTT_PASSWORD unset for an anonymous MQTT broker.

MQTT_HOST=
MQTT_PORT=
MQTT_USER=
MQTT_PASSWORD=
